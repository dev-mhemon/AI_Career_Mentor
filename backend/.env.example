# Supabase is Auth AND application database. Use a session-capable connection, not a transaction pooler.
DB_HOST=127.0.0.1
DB_PORT=56322
DB_USER=postgres
DB_PASSWORD=replace_with_database_password
DB_NAME=postgres
PORT=3200
SUPABASE_URL=http://127.0.0.1:56321
# Public anon JWT (role=anon) or sb_publishable_ key; NEVER a service_role/secret key.
SUPABASE_ANON_KEY=replace_with_local_public_key
# Optional override, otherwise derived from SUPABASE_URL.
SUPABASE_JWKS_URL=http://127.0.0.1:56321/auth/v1/.well-known/jwks.json

# Shared Auth abuse-control enabler (M01-02). Uncomment together when configuring it.
# Existing routes do not yet invoke this helper; an unconfigured helper returns retryable 503.
# AUTH_REDIS_URL may contain credentials: server-only, never log or commit real values.
# Use one Redis 7+ standalone authority with noeviction and identical policy/secret on every instance.
# AUTH_REDIS_URL=redis://127.0.0.1:56379
# AUTH_HMAC_SECRET=replace_with_at_least_32_random_secret_bytes
# Versioned operating defaults; positive integer overrides are supported.
# AUTH_OTP_TTL_SECONDS=600
# AUTH_OTP_MAX_FAILURES=5
# AUTH_RESEND_COOLDOWN_SECONDS=60
# AUTH_SEND_CONTACT_LIMIT=3
# AUTH_SEND_IP_LIMIT=10
# AUTH_SEND_WINDOW_SECONDS=900
# AUTH_LOGIN_MAX_FAILURES=5
# AUTH_LOGIN_WINDOW_SECONDS=900
# AUTH_LOGIN_LOCKOUT_SECONDS=900
# AUTH_REDIS_TIMEOUT_MS=1000
# AUTH_REDIS_RETRY_SECONDS=5
