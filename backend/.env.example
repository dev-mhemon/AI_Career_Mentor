# Supabase is Auth AND application database. Use a session-capable connection, not a transaction pooler.
DB_HOST=127.0.0.1
DB_PORT=56322
DB_USER=postgres
DB_PASSWORD=replace_with_database_password
DB_NAME=postgres
PORT=3200
SUPABASE_URL=http://127.0.0.1:56321
# Public anon JWT (role=anon) or sb_publishable_ key; NEVER a service_role/secret key.
SUPABASE_ANON_KEY=replace_with_local_public_key
# Optional override, otherwise derived from SUPABASE_URL.
SUPABASE_JWKS_URL=http://127.0.0.1:56321/auth/v1/.well-known/jwks.json
# Optional comma-separated proxy IP/CIDR allowlist. Leave unset for direct clients.
# Configure only ingress peers that cannot be reached around. A trusted proxy must
# forward a valid client IP; missing/invalid X-Forwarded-For fails closed.
# AUTH_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Optional backend registration minimum; default 8, accepted range 8..128.
# AUTH_PASSWORD_MIN_LENGTH=8

# Shared Auth abuse-control enabler (M01-02). Uncomment together when configuring it.
# A01/A04 call this helper after their provider gate; an unconfigured helper returns retryable 503.
# AUTH_REDIS_URL may contain credentials: server-only, never log or commit real values.
# Use one Redis 7+ standalone authority with noeviction and identical policy/secret on every instance.
# AUTH_REDIS_URL=redis://127.0.0.1:56379
# AUTH_HMAC_SECRET=replace_with_at_least_32_random_secret_bytes
# Dedicated HMAC secret for Candidate S1 6-digit OTP secret digests in Redis.
# AUTH_OTP_HMAC_SECRET=replace_with_at_least_32_random_secret_bytes
# Optional email dispatch transport for Candidate S1 OTP delivery (M01-08).
# When unconfigured, OTP email challenge dispatch fails closed with 503 SERVICE_UNAVAILABLE.
# Transport selection precedence (first configured wins):
#   1) MAILPIT_URL
#   2) AUTH_EMAIL_WEBHOOK_URL / AUTH_EMAIL_TRANSPORT_URL / EMAIL_TRANSPORT_URL
#   3) RESEND_API_KEY (+ AUTH_EMAIL_FROM)
#   4) SMTP_HOST + SMTP_USER + SMTP_PASS + AUTH_EMAIL_FROM
# Important: earlier transports (especially MAILPIT_URL) must be UNSET in the effective
# environment for SMTP to be selected. Because scripts/foundation/local.mjs injects MAILPIT_URL
# automatically for local dev, start the backend directly (e.g. `cd backend && npm run start:dev`)
# with MAILPIT_URL unset when testing SMTP locally.
# 1) Local dev Mailpit HTTP send API (loopback http; posts { From, To, Subject, Text }):
# MAILPIT_URL=http://127.0.0.1:8025/api/v1/send
# 2) Generic webhook HTTP POST transport (posts { to, otp, subject }; remote requires https:):
# AUTH_EMAIL_WEBHOOK_URL=https://mail.example.com/api/v1/send
# AUTH_EMAIL_TRANSPORT_KEY=replace_with_webhook_auth_token
# 3) Resend API (requires verified sender domain in AUTH_EMAIL_FROM):
# RESEND_API_KEY=re_replace_with_resend_api_key
# AUTH_EMAIL_FROM=noreply@example.com
# 4) SMTP transport via Nodemailer (e.g., Gmail App Password or any standard SMTP provider).
#    Port 465 defaults to implicit TLS (SMTP_SECURE=true); non-465 ports (e.g. 587) default to
#    SMTP_SECURE=false with mandatory STARTTLS (requireTLS: true).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=replace_with_smtp_app_password
# AUTH_EMAIL_FROM=AI Career Mentor <your-account@gmail.com>

# Optional TextBee SMS dispatch transport for phone OTP delivery (M03-05).
# When TEXTBEE_API_KEY is configured, dispatches real SMS via TextBee REST API.
# In non-production (NODE_ENV !== 'production') when unset and MAILPIT_URL is configured,
# falls back to Mailpit (${sanitizedPhone}@sms.local) for offline local development and CI E2E.
# In production without TEXTBEE_API_KEY, SMS delivery fails closed with 503 SERVICE_UNAVAILABLE.
# TEXTBEE_API_KEY=replace_with_textbee_api_key
# Optional specific device ID (uses /gateway/devices/{deviceId}/send-sms instead of /gateway/send-sms)
# TEXTBEE_DEVICE_ID=replace_with_textbee_device_id
# TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
# TEXTBEE_TIMEOUT_MS=10000
# Optional external OAuth providers for local Supabase GoTrue (Google & Facebook).
# Configure the exact OAuth callback URI in Google Cloud Console & Meta App Dashboard:
#   http://127.0.0.1:56321/auth/v1/callback
# When both Client ID and Secret are set for a provider using matching aliases from the same naming family within the same source
# (e.g., GOOGLE_CLIENT_ID must be paired with GOOGLE_CLIENT_SECRET; it cannot be paired with SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET),
# scripts/foundation/local.mjs automatically enables [auth.external.google] / [auth.external.facebook]
# in .local/foundation/supabase/config.toml. Mixed alias pairs or values split across sources do not enable the provider.
# GOOGLE_CLIENT_ID=replace_with_google_client_id
# GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
# FACEBOOK_CLIENT_ID=replace_with_facebook_app_id
# FACEBOOK_CLIENT_SECRET=replace_with_facebook_app_secret
# (Aliases SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID / SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET and
#  SUPABASE_AUTH_EXTERNAL_FACEBOOK_CLIENT_ID / SUPABASE_AUTH_EXTERNAL_FACEBOOK_SECRET are also supported.)

# Versioned operating defaults; positive integer overrides are supported.
# AUTH_OTP_TTL_SECONDS=600
# AUTH_OTP_MAX_FAILURES=5
# AUTH_RESEND_COOLDOWN_SECONDS=60
# AUTH_SEND_CONTACT_LIMIT=3
# AUTH_SEND_IP_LIMIT=10
# AUTH_SEND_WINDOW_SECONDS=900
# AUTH_LOGIN_MAX_FAILURES=5
# AUTH_LOGIN_WINDOW_SECONDS=900
# AUTH_LOGIN_LOCKOUT_SECONDS=900
# AUTH_REDIS_TIMEOUT_MS=1000
# AUTH_REDIS_RETRY_SECONDS=5

# Redis 24h H-IDEM Replay Control & Loss-Epoch Fail-Closed Barrier (M04-01 / R14).
# Defaults to AUTH_REDIS_URL or REDIS_URL when IDEMPOTENCY_REDIS_URL is unset or blank.
# IDEMPOTENCY_REDIS_EPOCH holds the deployment-acknowledged Redis epoch marker (idempotency:epoch)
# used to detect whole-store flushes or restarts. Requires a Redis deployment with
# `maxmemory-policy noeviction` (especially when sharing AUTH_REDIS_URL) so individual 24h
# replay keys are never evicted while the epoch marker survives.
# After any flush, restart, restore, or replica promotion with suspected write loss, operators MUST
# first complete the traffic fence (rotate IDEMPOTENCY_REDIS_EPOCH / suspend ingress) and confirmed
# handler drain (stop/fence pre-loss handlers), keeping replay unavailable (fail-closed 503
# SERVICE_UNAVAILABLE), and only then reopen via acknowledgeEpoch() once EITHER:
# (a) durable replay-state reconciliation restores missing records with original responses and
#     remaining deadlines, OR
# (b) a wait covering the longest configured IDEMPOTENCY_TTL_SECONDS reservation lifetime (default 24h) has elapsed.
# IDEMPOTENCY_REDIS_URL=redis://127.0.0.1:56379
# IDEMPOTENCY_REDIS_EPOCH=epoch-v1
# IDEMPOTENCY_TTL_SECONDS=86400
# IDEMPOTENCY_REDIS_TIMEOUT_MS=1000
# IDEMPOTENCY_REDIS_RETRY_SECONDS=5

# Durable Postgres Job Queue, Reaper & Internal AI Gateway Operating Defaults (M04-02 / R13 / R26).
# Server-only operating bounds; never expose provider keys or raw prompts to clients.
# JOB_WORKER_LEASE_SECONDS=120
# JOB_WORKER_HEARTBEAT_SECONDS=30
# JOB_WORKER_MAX_ATTEMPTS=5
# JOB_WORKER_MAX_AGE_SECONDS=3600
# JOB_REAPER_INTERVAL_SECONDS=30
# JOB_POLL_INTERVAL_MS=1000
# JOB_RETRY_AFTER_SECONDS=3
# AI_QUOTA_CACHE_TTL_MS=5000
# AI_EXECUTION_MODE=real_user

# Optional Google Gemini provider configuration for AI_EXECUTION_MODE=real_user.
# Server-only secret; leave unset to fail closed via UnconfiguredRealUserProviderAdapter.
# GEMINI_API_KEY=
# GEMINI_TIMEOUT_MS=30000
