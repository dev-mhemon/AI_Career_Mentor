# Supabase is Auth AND application database. Use a session-capable connection, not a transaction pooler.
DB_HOST=127.0.0.1
DB_PORT=56322
DB_USER=postgres
DB_PASSWORD=replace_with_database_password
DB_NAME=postgres
PORT=3200
SUPABASE_URL=http://127.0.0.1:56321
# Public anon JWT (role=anon) or sb_publishable_ key; NEVER a service_role/secret key.
SUPABASE_ANON_KEY=replace_with_local_public_key
# Optional override, otherwise derived from SUPABASE_URL.
SUPABASE_JWKS_URL=http://127.0.0.1:56321/auth/v1/.well-known/jwks.json
